{
  "name": "rastavec",
  "version": "0.4.0-beta.1",
  "description": "RastaVec CLI — Smooth vectors. Good vibes. Raster to SVG with analysis, fidelity metrics and deterministic auto-tuning. JSON output for scripts and AI agents.",
  "license": "Apache-2.0",
  "author": "jberdah",
  "homepage": "https://github.com/jberdah/rastavec",
  "repository": {
