{
  "name": "rastavec",
  "private": true,
  "version": "0.5.0-beta.5",
  "type": "module",
  "scripts": {
    "predev": "node scripts/verify-vtracer-next.mjs",
    "dev": "vite",
    "build:vtracer-next": "node scripts/build-vtracer-next.mjs",
    "precheck": "node scripts/verify-vtracer-next.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "prebuild": "node scripts/verify-vtracer-next.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name rastavec",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.28.1",
    "svelte-check": "^4.1.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-wasm": "^3.6.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "jszip": "^3.10.2",
    "onnxruntime-web": "1.31.1",
    "utif2": "4.1.0"
  },
  "description": "RastaVec — Smooth vectors. Good vibes. Raster to SVG: vectorise, compare, auto-tune, locally.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jberdah/rastavec.git"
  },
  "homepage": "https://github.com/jberdah/rastavec"
}
