{
  "name": "svg-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name svg-studio"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.28.1",
    "svelte-check": "^4.1.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-wasm": "^3.6.0"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "vtracer-webapp": "^0.4.0"
  },
  "description": "Raster to SVG studio: vectorise, compare, auto-tune — in the browser."
}
